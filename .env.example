# ---------------------------------------------------------------------------
# CampusMeal backend - environment template (development values only).
# Copy to .env and adjust. Never commit a real .env file.
# ---------------------------------------------------------------------------

# Required (validated at startup - Issue #1)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://campusmeal:campusmeal_dev@localhost:5432/campusmeal
APP_TIMEZONE=America/Bogota

# Optional: enable TLS for managed PostgreSQL providers (local Docker uses false)
DATABASE_SSL=false

# Optional: host port for the Docker Compose PostgreSQL service (default 5432).
# Change it if another PostgreSQL already listens on 5432, and update DATABASE_URL.
POSTGRES_PORT=5432

# Required: authentication (Issue #2)
# The app refuses to start with these placeholders. Generate two DIFFERENT values:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Secrets must be >= 32 characters. TTLs use s/m/h/d (e.g. 15m, 7d); access < refresh.
JWT_ACCESS_SECRET=replace-with-a-random-access-token-signing-key
JWT_REFRESH_SECRET=replace-with-a-random-refresh-token-signing-key
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Only for `npm run seed:auth` (not needed to start the API).
# Passwords: 8-128 chars with an uppercase letter, a lowercase letter and a number.
DEMO_USER_NAME=CampusMeal Demo
DEMO_USER_EMAIL=demo@campusmeal.local
DEMO_USER_PASSWORD=
DEMO_ANALYST_NAME=CampusMeal Analyst
DEMO_ANALYST_EMAIL=analyst@campusmeal.local
DEMO_ANALYST_PASSWORD=

# Reserved for the route-provider issue - not used yet
ROUTE_PROVIDER_MODE=deterministic
ROUTE_PROVIDER_URL=
ROUTE_PROVIDER_API_KEY=
ROUTE_PROVIDER_TIMEOUT_MS=5000
