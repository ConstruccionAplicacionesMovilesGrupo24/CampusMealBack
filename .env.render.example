# ---------------------------------------------------------------------------
# CampusMeal backend - deployment template for Render Free + Neon Free.
# Placeholders only. The app and the migration/seed commands refuse to start with
# these values on purpose: the team must supply real private values.
#
# Two uses (see docs/DEPLOYMENT_RENDER_NEON.md):
#   1. Copy to .env.render (ignored by Git) and fill it in to run the compiled
#      migrations/seeds against Neon from your machine:
#        node --env-file=.env.render dist/database/seeds/auth.seed.js
#   2. Enter the RUNTIME section values in Render > Environment. Never upload this
#      file or .env.render anywhere; never commit real values.
# Do not wrap values in quotes and do not leave spaces around "=".
# ---------------------------------------------------------------------------

# ----- RUNTIME: set these in Render > Environment -----

# "production" also makes the TypeORM CLI/seeds ignore the development .env file.
NODE_ENV=production

# Render injects PORT for the web service: do NOT add PORT in Render.
# Locally the validator still requires a value, even though migrations/seeds never listen on it.
PORT=3000

# Neon DIRECT (non-pooled) connection string. Copy it from Neon > Connect with
# "Connection pooling" turned off (the host must NOT contain "-pooler").
# Change sslmode=require to sslmode=verify-full: node-postgres already verifies the
# certificate for "require" but prints a deprecation warning; verify-full states it explicitly.
DATABASE_URL=postgresql://NEON_USER:NEON_PASSWORD@ep-example-000000.us-east-1.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_SSL=true

APP_TIMEZONE=America/Bogota

# Generate two DIFFERENT values locally (never paste them into chat, docs or tickets):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Keep them stable across redeploys: changing them invalidates every issued token.
JWT_ACCESS_SECRET=replace-with-a-random-access-token-signing-key
JWT_REFRESH_SECRET=replace-with-a-random-refresh-token-signing-key
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# valhalla: real pedestrian walking times from the public FOSSGIS Valhalla instance
# (no API key, fair use, no SLA). Leave ROUTE_PROVIDER_URL empty to use that default.
# ROUTE_PROVIDER_API_KEY is only read by ROUTE_PROVIDER_MODE=external.
ROUTE_PROVIDER_MODE=valhalla
ROUTE_PROVIDER_URL=
ROUTE_PROVIDER_API_KEY=
ROUTE_PROVIDER_TIMEOUT_MS=5000

# ----- SEED-ONLY: keep these in your local .env.render, NOT in Render -----

# Required by seed:auth; seed:inventory reads DEMO_USER_EMAIL.
# Passwords: 8-128 chars with an uppercase letter, a lowercase letter and a number.
DEMO_USER_NAME=CampusMeal Demo
DEMO_USER_EMAIL=demo@campusmeal.local
DEMO_USER_PASSWORD=
DEMO_ANALYST_NAME=CampusMeal Analyst
DEMO_ANALYST_EMAIL=analyst@campusmeal.local
DEMO_ANALYST_PASSWORD=

# Optional for seed:usage (defaults to the previous month in Bogota), format YYYY-MM.
USAGE_SEED_MONTH=
